#!/bin/sh
# Installs the runtime dependencies of the Debian 13 LPMT build (WITH_HWDECODE=1).
#   install-deps          install packages (needs root)
#   install-deps --list   print the package list and exit
# The NDI runtime is not handled here (license); install libndi.so into /usr/local/lib manually.
set -e

# libraries the binary links directly (verified against the binary in debian/Docker.build)
LINKED="
libc6
libgcc-s1
libasound2t64
libcurl4t64
libfontconfig1
libfreeimage3
libfreetype6
libgl1
libglew2.2
libglfw3
libglib2.0-0t64
libgstreamer-gl1.0-0
libgstreamer-plugins-base1.0-0
libgstreamer1.0-0
libgtk-3-0t64
libjack0
libmpg123-0t64
libopenal1
libpocofoundation100
libsndfile1
libstdc++6
libudev1
liburiparser1
libx11-6
"

# GStreamer plugins: qtdemux/h264parse/vah264dec/glupload for the hardware path,
# playbin + alsa sink for what ofVideoPlayer still handles
GSTREAMER="
gstreamer1.0-plugins-base
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad
gstreamer1.0-gl
gstreamer1.0-alsa
gstreamer1.0-x
"

# VA-API drivers for hardware decode, avahi for NDI source discovery
SYSTEM="
libva-drm2
vainfo
avahi-daemon
libavahi-client3
"

case "$1" in
--list)
    echo "$LINKED$GSTREAMER$SYSTEM" | grep .
    exit 0 ;;
"")
    ;;
*)
    echo "usage: $0 [--list]" >&2
    exit 1 ;;
esac

if [ "$(id -u)" != 0 ]; then
    echo "this script must be run as root" >&2
    exit 1
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
# shellcheck disable=SC2086
apt-get install -y $LINKED $GSTREAMER $SYSTEM

echo "Done. Unpack the build output anywhere and run ./lpmt from that directory."
